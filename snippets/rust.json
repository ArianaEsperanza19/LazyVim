  "Macro Quick Print (No Newline)": {
    "prefix": [
      "myprint_macro"
    ],
    "body": [
      "use std::io::{self, Write};",
      "macro_rules! my_print {",
      "    (\\$(\\$arg:tt)*) => {",
      "        print!(\\$(\\$arg)*);",
      "        io::stdout().flush().expect(\"Fallo al vaciar el búfer\");",
      "    };",
      "}",
      "$0"
    ],
    "description": [
      "Macro para imprimir sin salto de línea y forzar el flush inmediatamente."
    ]
  },
