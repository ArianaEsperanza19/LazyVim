{
    "Plantilla de Documento Completa": {
        "prefix": "docinit",
        "body": [
            "#set page(",
            "\tpaper: \"${1:a4}\",",
            "\tmargin: (x: ${2:2.5cm}, y: ${3:2.5cm}),",
            "\tnumbering: \"1\",",
            ")",
            "#set text(",
            "\tfont: ${4:Cormorant Garamont},",
            "\tlang: \"es\",",
            "\tsize: ${5:11pt}",
            ")",
            "#set par(justify: true)",
            "",
            "#align(center)[",
            "\t#text(size: 2em, weight: \"bold\")[${6:Título del Documento}] \\",
            "\t#text(size: 1.2em)[${7:Autor}]",
            "]",
            "",
            "$0"
        ],
        "description": "Configuración inicial completa para un documento nuevo"
    },
    "Alinear al Centro": {
        "prefix": "alc",
        "body": [
            "#align(center)[",
            "\t$0",
            "]"
        ],
        "description": "Crea un bloque alineado al centro rápidamente"
    },
    "Alinear al Centro con Texto": {
        "prefix": "alct",
        "body": [
            "#align(center)[#text(size: ${1:11pt}, weight: \"${2:bold}\")[$0]]"
        ],
        "description": "Centra texto con tamaño y peso ajustable"
    },
    "Configuración de Texto Básica": {
        "prefix": "txt",
        "body": [
            "#text(font: \"${1:Linux Libertine}\", size: ${2:11pt}, fill: ${3:black})[${0}]"
        ],
        "description": "Inserta una función #text() con parámetros básicos"
    },
    "Regla de Texto Set": {
        "prefix": "stxt",
        "body": [
            "#set text(",
            "\tfont: \"${1:New Computer Modern}\",",
            "\tsize: ${2:10pt},",
            "\tlang: \"${3:es}\"",
            ")",
            "$0"
        ],
        "description": "Establece la regla de texto para el resto del documento"
    },
    "Configuración de Párrafo": {
        "prefix": "par",
        "body": [
            "#set par(justify: ${1|true,false|}, leading: ${2:0.65em})[]",
            "$0"
        ],
        "description": "Configura la justificación y el interlineado"
    },
    "Grid Dos Columnas": {
        "prefix": "gridcol",
        "body": [
            "#grid(",
            "\tcolumns: (1fr, 1fr),",
            "\tgutter: ${1:1em},",
            "\t[${2:Contenido columna 1}],",
            "\t[${3:Contenido columna 2}]",
            ")$0"
        ],
        "description": "Crea una rejilla de dos columnas con ancho flexible"
    },
    "Grid Dos Filas": {
        "prefix": "gridrow",
        "body": [
            "#grid(",
            "\trows: (${1:auto}, ${2:auto}),",
            "\tgutter: ${3:1em},",
            "\t[${4:Contenido fila 1}],",
            "\t[${5:Contenido fila 2}]",
            ")$0"
        ],
        "description": "Crea una rejilla de dos filas"
    },
    "Grid Configurable": {
        "prefix": "grid2x2",
        "body": [
            "#grid(",
            "\tcolumns: (${1:1fr, 1fr}),",
            "\trows: (${2:auto, auto}),",
            "\tgutter: ${3:1em},",
            "\t[${4:Celda 1-1}], [${5:Celda 1-2}],",
            "\t[${6:Celda 2-1}], [${7:Celda 2-2}]",
            ")$0"
        ],
        "description": "Crea una rejilla de 2x2"
    },
    "Tabla Dos Columnas": {
        "prefix": "tblcol",
        "body": [
            "#table(",
            "\tcolumns: (1fr, 1fr),",
            "\tinset: ${1:10pt},",
            "\talign: ${2:horizon},",
            "\ttable.header(",
            "\t\t[*${3:Título 1}*], [*${4:Título 2}*],",
            "\t),",
            "\t[${5:Dato 1}], [${6:Dato 2}],",
            "\t[${7:Dato 3}], [${8:Dato 4}]",
            ")$0"
        ],
        "description": "Crea una tabla con dos columnas y encabezado"
    },
    "Tabla Dos Filas": {
        "prefix": "tblrow",
        "body": [
            "#table(",
            "\tcolumns: ${1:1fr},",
            "\trows: (auto, auto),",
            "\tinset: ${2:8pt},",
            "\t[${3:Contenido Fila 1}],",
            "\t[${4:Contenido Fila 2}]",
            ")$0"
        ],
        "description": "Crea una tabla con dos filas definidas"
    },
    "Tabla Estilizada 2x2": {
        "prefix": "tbl2x2",
        "body": [
            "#table(",
            "\tcolumns: (${1:1fr, 1fr}),",
            "\tinset: 10pt,",
            "\tfill: (x, y) => if calc.even(y) { ${2:gray.lighten(50%)} } else { ${3:white} },",
            "\t[*${4:Header A}*], [*${5:Header B}*],",
            "\t[${6:Celda 1-1}], [${7:Celda 1-2}],",
            "\t[${8:Celda 2-1}], [${9:Celda 2-2}]",
            ")$0"
        ],
        "description": "Tabla de 2x2 con filas de colores alternos"
    },
    "Figura de Imagen": {
        "prefix": "fig",
        "body": [
            "#figure(",
            "\timage(\"${1:ruta/al/archivo.png}\", width: ${2:80%}),",
            "\tcaption: [${3:Descripción de la imagen}],",
            ")${4:<fig-${5:id}>}$0"
        ],
        "description": "Inserta una figura con una imagen y etiqueta de referencia"
    },
    "Figura de Tabla": {
        "prefix": "figtbl",
        "body": [
            "#figure(",
            "\ttable(",
            "\t\tcolumns: (${1:1fr, 1fr}),",
            "\t\t[${2:Dato A}], [${3:Dato B}],",
            "\t),",
            "\tcaption: [${4:Título de la tabla}],",
            ")${5:<tbl-${6:id}>}$0"
        ],
        "description": "Envuelve una tabla en un bloque de figura"
    },
    "Matriz Dinámica": {
        "prefix": "mat",
        "body": [
            "mat(",
            "\t${1:a}, ${2:b};",
            "\t${3:c}, ${4:d}",
            ")$0"
        ],
        "description": "Inserta una matriz 2x2 básica"
    },
    "Referencia Cruzada Rápida": {
        "prefix": "ref",
        "body": [
            "@${1|fig,tbl,eq,lst|}-${2:id}$0"
        ],
        "description": "Inserta una referencia cruzada con selector de prefijo"
    },
    "Bloque de Términos (Glosario)": {
        "prefix": "terms",
        "body": [
            "/ ${1:Término}: ${2:Definición}",
            "/ ${3:Otro}: ${4:Explicación}$0"
        ],
        "description": "Crea una lista de términos/descripciones rápidamente"
    },
    "Línea Horizontal (Separador)": {
        "prefix": "hr",
        "body": [
            "#line(length: 100%, stroke: ${1:0.5pt + gray})",
            "$0"
        ],
        "description": "Inserta una línea divisoria horizontal"
    },
    "Nota al Pie": {
        "prefix": "fn",
        "body": [
            "#footnote[${1:Contenido de la nota}]$0"
        ],
        "description": "Inserta una nota al pie de página"
    },
    "Contenedor de Color (Box)": {
        "prefix": "bbox",
        "body": [
            "#block(",
            "\tfill: ${1:luma(240)},",
            "\tinset: ${2:8pt},",
            "\tradius: ${3:4pt},",
            "\twidth: 100%,",
            ")[",
            "\t${0:Contenido importante}",
            "]"
        ],
        "description": "Crea un bloque de texto resaltado con fondo de color"
    },
    "Arreglo (Array)": {
        "prefix": "arr",
        "body": [
            "#let ${1:mi_arreglo} = (${2:\"item1\", \"item2\", \"item3\"})$0"
        ],
        "description": "Declara un arreglo (lista) de elementos"
    },
    "Diccionario (Dictionary)": {
        "prefix": "dict",
        "body": [
            "#let ${1:mi_dict} = (",
            "\t${2:clave}: ${3:\"valor\"},",
            "\t${4:otra_clave}: ${5:100},",
            ")$0"
        ],
        "description": "Declara un diccionario (objeto clave-valor)"
    },
    "Ciclo For Simple": {
        "prefix": "for",
        "body": [
            "#for ${1:item} in ${2:mi_arreglo} [",
            "\t- ${1:item}$0",
            "]"
        ],
        "description": "Itera sobre una lista y genera contenido"
    },
    "Ciclo For con Clave y Valor": {
        "prefix": "forkv",
        "body": [
            "#for (${1:clave}, ${2:valor}) in ${3:mi_dict} [",
            "\t*${1:clave}*: ${2:valor} \\",
            "]$0"
        ],
        "description": "Itera sobre un diccionario obteniendo claves y valores"
    },
    "Ciclo For de Rango (Números)": {
        "prefix": "forrange",
        "body": [
            "#for ${1:i} in range(${2:1}, ${3:11}) [",
            "\tNúmero ${1:i} \\",
            "]$0"
        ],
        "description": "Itera sobre un rango numérico específico"
    },
    "Filtrado de Arreglo (map/filter)": {
        "prefix": "arrmap",
        "body": [
            "${1:#mi_arreglo}.map(${2:it} => [${3:*#${2:it}*}]).join(${4:[, ]})$0"
        ],
        "description": "Transforma elementos de un arreglo y los une con un separador"
    },
    "Encabezado Global (Todas las páginas)": {
        "prefix": "headerset",
        "body": [
            "#set page(",
            "\theader: [",
            "\t\t#set text(size: 9pt, style: \"italic\")",
            "\t\t${1:Título del Documento}",
            "\t\t#v(10pt)",
            "\t\t${2:Autor/Institución}",
            "\t\t#line(length: 100%, stroke: 0.5pt)",
            "\t],",
            ")$0"
        ],
        "description": "Establece un encabezado que se repetirá en todas las páginas"
    },
    "Encabezado de Página Única (Portada/Título)": {
        "prefix": "headersimple",
        "body": [
            "#place(top)[",
            "\t#grid(",
            "\t\tcolumns: (1fr, auto),",
            "\t\t[",
            "\t\t\t#text(size: 1.5em, weight: \"bold\")[${1:Título Principal}] \\",
            "\t\t\t#text(size: 1.1em, fill: gray)[${2:Subtítulo o Fecha}]",
            "\t\t],",
            "\t\t[",
            "\t\t\t#image(\"${3:logo.png}\", width: ${4:3cm})",
            "\t\t]",
            "\t)",
            "\t//#v(1em)",
            "\t#line(length: 100%, stroke: 0.5pt + black)",
            "]",
            "#v(${5:2cm})$0"
        ],
        "description": "Crea un encabezado estilo membrete que solo aparece una vez en la posición actual"
    },
    "Encabezado Global con Grid 2 Col": {
        "prefix": "headergrid",
        "body": [
            "#set page(",
            "\theader: [",
            "\t\t#grid(",
            "\t\t\tcolumns: (1fr, 1fr),",
            "\t\t\talign: (left, right),",
            "\t\t\t[ ${1:*Institución*} ],",
            "\t\t\t[ ${2:Departamento de Ingeniería} ],",
            "\t\t)",
            "\t\t#v(-0.5em)",
            "\t\t#line(length: 100%, stroke: 0.5pt)",
            "\t]",
            ")$0"
        ],
        "description": "Configura un encabezado global dividido en dos columnas alineadas a los extremos"
    },
    "Encabezado Global con Grid (3 Col)": {
        "prefix": "headergridc3",
        "body": [
            "#set page(",
            "\theader: [",
            "\t\t#grid(",
            "\t\t\tcolumns: (1fr, 1fr, 1fr),",
            "\t\t\talign: (left, center, right),",
            "\t\t\t[ ${1:Izquierda} ],",
            "\t\t\t[ ${2:Centro} ],",
            "\t\t\t[ ${3:Derecha} ],",
            "\t\t)",
            "\t\t#line(length: 100%, stroke: 0.5pt)",
            "\t]",
            ")$0"
        ],
        "description": "Encabezado global dividido en tres partes (izq, centro, der)"
    },
    "Membrete Único con Grid y Logo": {
        "prefix": "headergrid2x2",
        "body": [
            "#grid(",
            "\tcolumns: (1fr, 1fr),",
            "\talign: (bottom + left, bottom + right),",
            "\t[",
            "\t\t#text(14pt, weight: \"bold\")[${1:Nombre del Proyecto}] \\",
            "\t\t#text(10pt, fill: gray)[${2:ID: 123456789}]",
            "\t],",
            "\t[",
            "\t\t#set text(9pt)",
            "\t\t${3:Ciudad, País} \\",
            "\t\t${4:mail.com}",
            "\t]",
            ")",
            "#v(0.5em)",
            "#line(length: 100%, stroke: 1.5pt)$0"
        ],
        "description": "Crea un bloque de encabezado manual para la primera página usando grid"
    },
    "Encabezado de Trabajo Académico": {
        "prefix": "gridtrabajo",
        "body": [
            "#grid(",
            "\tcolumns: (1fr, 1fr),",
            "\talign(left)[",
            "\t\t*Prof. Ariana Uribe* \\",
            "\t\tTrayecto ${1: n} \\",
            "\t\tSección: ${2:Seccion}",
            "\t],",
            "\talign(right)[",
            "\t\t*Materia:* ${3:Materia} \\",
            "\t\t*Fecha:* #datetime.today().display(\"[day]/[month]/[year]\") \\",
            "\t\tPNF en Informática",
            "\t],",
            ")",
            "#line(length: 100%, stroke: 1.5pt)",
            "$0"
        ],
        "description": "Encabezado con datos de profesor, sección, materia y fecha automática"
    }
}
